# Copiar a .env y rellenar. El archivo .env NUNCA se sube al repositorio.
APP_ENV=local
# Logs: JSON en la nube, texto legible en local
LOG_LEVEL=INFO
LOG_JSON=true
APP_NAME=plataforma
APP_VERSION=0.1.0
GIT_COMMIT=dev
API_V1_PREFIX=/api/v1

# Base de datos. En local, sqlite. En produccion, cadena del SESSION POOLER de Supabase
# (host aws-...pooler.supabase.com, puerto 5432). No usar la conexion directa: es IPv6.
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg2://postgres.REF:CAMBIAR@aws-0-REGION.pooler.supabase.com:5432/postgres

# Autenticacion
JWT_SECRET=CAMBIAR_POR_UNA_CADENA_ALEATORIA_LARGA
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS: origenes exactos separados por coma, sin comodin
CORS_ORIGINS=http://localhost:5173,https://ORG.github.io

# PreparadorIA: implementacion del puerto de preparacion de retos
PREPARADOR=reglas
LLM_API_KEY=
LLM_MODEL=

# EvaluadorAislado: implementacion del puerto de evaluacion
EVALUADOR=simulado

# Credenciales
PREFIJO_CREDENCIAL=SH
URL_BASE_VERIFICACION=http://localhost:5173/#/credenciales
SEED_ON_START=false
